# Local render used while checking the office. Not part of the game.
office_preview.png
office_preview.png.import

# Godot 4 editor cache and imported binaries.
# Sidecar *.import files and *.gd.uid files stay tracked.
.godot/

# Godot 3 import folder. This does not ignore *.import files.
.import/

# Generated translation binaries. Source CSV/PO files stay tracked.
*.translation

# Export caches and build output. export_presets.cfg stays tracked.
export.cfg
/build/
/exports/
*.tmp

# Local result from the project hook. Not a source file.
.cursor/hooks/last-sync-result.txt

